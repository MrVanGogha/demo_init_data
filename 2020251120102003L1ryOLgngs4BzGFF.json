      "start_time": "00:03:27",
      "translated_text": "",
      "relative_start_time": "00:03:27",
      "speaker": "SPEAKER_00",
      "original_text": "如果要破案或者要做线索，都是跟电数据相还的。",
      "source_language": "中文",
      "end_time": "00:03:33",
      "relative_end_time": "00:03:33",
