      "relative_start_time": "00:02:24",
      "translated_text": "",
      "start_time": "00:02:24",
      "speaker": "SPEAKER_00",
      "original_text": "感谢观看在实际案例中，有没有哪一个案例让您的印象特别深刻。",
      "source_language": "中文",
      "end_time": "00:03:26",
