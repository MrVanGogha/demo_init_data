      "start_time": "00:00:11",
      "translated_text": "",
      "relative_start_time": "00:00:11",
      "speaker": "SPEAKER_01",
      "original_text": "信息安全也被越来越多的提及，您认为应该感到焦虑吗？",
      "source_language": "中文",
      "end_time": "00:00:17",
      "relative_end_time": "00:00:17",
