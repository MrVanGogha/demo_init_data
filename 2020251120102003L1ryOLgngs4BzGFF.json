      "start_time": "00:00:30",
      "translated_text": "",
      "relative_start_time": "00:00:30",
      "speaker": "SPEAKER_01",
      "original_text": "本节目由上海证券报、中国证券网出品由中国上市公司协会指导。",
      "source_language": "中文",
      "end_time": "00:00:37",
      "relative_end_time": "00:00:37",
